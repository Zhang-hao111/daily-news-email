# DeepSeek AI
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# QQ 邮箱 SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq_email@qq.com
SMTP_AUTH_CODE=your_auth_code_here
EMAIL_TO=recipient@example.com

# Obsidian（可选，不配置则跳过存档）
OBSIDIAN_VAULT_PATH=D:\ObsidianVault

# ---- 以下为可选配置（借鉴 TrendRadar），留空/缺省即可 ----

# 关注关键词（逗号分隔）：标题命中的文章在 AI 筛选时优先入选
FOCUS_KEYWORDS=

# 排除关键词（逗号分隔）：标题命中即过滤，用于拦截软文/广告
EXCLUDE_KEYWORDS=优惠券,限时优惠,免费领取,抽奖,福利,扫码,带货,种草

# 新闻新鲜度：超过 N 小时的文章不收录（防旧闻、配合去重防跨天重复）
NEWS_MAX_AGE_HOURS=36

# 群机器人推送（可选）：飞书/钉钉/企业微信的 webhook 地址，留空则不推送
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TYPE=feishu
